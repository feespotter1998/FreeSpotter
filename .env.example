# ─────────────────────────────────────────────────────────────
# FeeSpotter — Environment Variables Reference
# Copy this file to .env.local and insert your real keys/links
# ─────────────────────────────────────────────────────────────

# 1. Site Domain / Canonical URL (Used for sitemap and metadata)
NEXT_PUBLIC_SITE_URL="https://feespotter.com"

# 2. Authentication (Clerk — https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key_here"
CLERK_SECRET_KEY="your_clerk_secret_key_here"

# 3. Google Analytics / Measurement ID (Optional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# 4. Google AdSense (Once approved, grab your publisher ca-pub ID and ad slots)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD="1234567890"
NEXT_PUBLIC_ADSENSE_SLOT_COMPARATOR="1234567891"
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER="1234567892"

# 5. Marketplace Affiliate & Partner Links
# Etsy Partners
NEXT_PUBLIC_EVERBEE_AFFILIATE_URL="https://www.everbee.io/?via=FeeSpotter"
NEXT_PUBLIC_MUNBYN_AFFILIATE_URL="https://www.amazon.com/dp/B0885RLLG1?tag=feespotter-20"

# TikTok Shop Partners
NEXT_PUBLIC_KALODATA_AFFILIATE_URL="https://kalodata.com/?ref=feespotter"
NEXT_PUBLIC_PRINTIFY_AFFILIATE_URL="https://printify.com/?ref=feespotter"

# Amazon FBA Partners
NEXT_PUBLIC_HELIUM10_AFFILIATE_URL="https://crushit.helium10.com/?crsa=feespotter"
NEXT_PUBLIC_JUNGLESCOUT_AFFILIATE_URL="https://junglescout.com/?ref=feespotter"

# eBay Partners
NEXT_PUBLIC_ZIK_AFFILIATE_URL="https://zikanalytics.com/?ref=feespotter"

# Shopify DTC Partners
NEXT_PUBLIC_KLAVIYO_AFFILIATE_URL="https://klaviyo.com/?ref=feespotter"
